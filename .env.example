# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NOTE: every VITE_* value below is inlined into the client bundle and is public.
# Never put a secret (service role key, private API key, shared password) behind a
# VITE_ prefix. Access control must be enforced by Supabase Row Level Security.

# Supabase Configuration (anon key is public by design; RLS is the security boundary)
VITE_SUPABASE_URL="your_supabase_url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# TMDB API Configuration (public in the bundle; scope/rotate accordingly, or proxy
# TMDB calls through a backend if the key must stay private)
VITE_TMDB_API_KEY="your_tmdb_api_key"
